POSTGRES_USER=tabacchi
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=tabacchi_prezzi

# Espressione cron per lo scraping automatico (default: ogni lunedi alle 3:00)
SCRAPE_CRON=0 3 * * 1

# Se true, esegue subito uno scraping all'avvio del backend (utile la prima volta)
SCRAPE_ON_BOOT=true

# Token per proteggere gli endpoint di amministrazione (import manuale, forzatura scraping)
ADMIN_TOKEN=cambiami-token-sicuro

# Segreto usato per firmare i token di login (JWT). Genera un valore casuale con:
#   openssl rand -hex 32
JWT_SECRET=cambiami-con-una-stringa-casuale-lunga

# Chiave API Anthropic, necessaria per generare le recensioni AI dei sigari.
# Ottienila da https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Domini consentiti (separati da virgola, senza spazi) da cui il modello può
# attingere per generare le recensioni. Lascia vuoto per nessuna restrizione
# (sconsigliato: il modello potrebbe usare fonti non verificate).
REVIEW_SOURCES=gustotabacco.it,accademiafumolento.forumfree.it,rollingtobacco.it,bottegadelfumatore.com,sigarietabacchi.it

# Modello usato per generare le recensioni. Di default il più economico
# disponibile (Haiku), sufficiente per sintetizzare recensioni testuali.
REVIEW_MODEL=claude-haiku-4-5-20251001

# Chiave per proteggere gli endpoint /api/ha/* usati dall'integrazione con
# Home Assistant (sensore REST per le statistiche, automazione per inviare la
# temperatura di una location). Lascia vuoto per disabilitare l'integrazione.
# Genera un valore casuale con: openssl rand -hex 32
HA_API_KEY=
